NODE_ENV=development
API_GATEWAY_PORT=3000
API_GATEWAY_LOG_LEVEL=info
CORS_ORIGINS=

API_GATEWAY_BACKENDS=
API_URL_1=http://localhost:8001
API_URL_2=http://localhost:8002
API_URL_3=http://localhost:8003
API_GATEWAY_MAX_CONN=100
API_GATEWAY_BACKEND_TIMEOUT=30000

API_GATEWAY_RATE_WINDOW=60000
API_GATEWAY_RATE_MAX=100

API_GATEWAY_CB_THRESHOLD=5
API_GATEWAY_CB_RECOVERY=30000
API_GATEWAY_CB_HALFOPEN=3

API_GATEWAY_HC_INTERVAL=30000
API_GATEWAY_HC_TIMEOUT=5000
API_GATEWAY_HC_PATH=/health

API_GATEWAY_PROXY_TIMEOUT=30000

API_GATEWAY_AUTH_ENABLED=false
API_GATEWAY_AUTH_HEADER=x-api-key
API_GATEWAY_AUTH_SECRETS=

API_GATEWAY_CACHE_ENABLED=false
API_GATEWAY_CACHE_TTL=60000
